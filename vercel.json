{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/next-vault-v3 run build",
  "outputDirectory": "artifacts/next-vault-v3/dist/public",
  "rewrites": [
    {
      "source": "/yf-proxy/:path*",
      "destination": "/api/yf-proxy?path=/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
