{
  "name": "nv---protocol",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "previews": {
    "vars": {
      "NV_PREVIEW_BUILD": "true"
    }
  },
  "observability": {
    "enabled": true
  }
}
